# ---- API (/api/.env) — never commit real values ----
GEMINI_API_KEY=
SARVAM_API_KEY=
GOOGLE_TTS_API_KEY=            # optional fallback
SAFE_BROWSING_API_KEY=         # optional, Google Safe Browsing
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # API only, never ship in the app
PORT=3000

# ---- App (/app/.env) — EXPO_PUBLIC_ values are visible in the app bundle ----
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
